{
  "agent-dev-toolkit-path-secrets-guard": {
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -ExecutionPolicy Bypass -File \"./config/hooks/guard-pre-tool.ps1\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
