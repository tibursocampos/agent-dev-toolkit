{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "type": "command",
        "command": "pwsh -NoProfile -ExecutionPolicy Bypass -File ./guard-pre-tool.ps1",
        "powershell": "pwsh -NoProfile -ExecutionPolicy Bypass -File ./guard-pre-tool.ps1",
        "cwd": "{{TOOLKIT_ROOT}}/hooks",
        "timeoutSec": 15
      }
    ]
  }
}
