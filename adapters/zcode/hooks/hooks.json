{
  "description": "agent-dev-toolkit ZCode ADE hooks (user-level under InstallRoot)",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "echo agent-dev-toolkit-zcode-session-start",
            "enabled": true
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File hooks/guard-pre-tool.ps1",
            "enabled": true
          }
        ]
      }
    ]
  }
}
