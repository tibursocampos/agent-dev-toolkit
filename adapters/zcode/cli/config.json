{
  "hooks": {
    "enabled": true,
    "timeoutMs": 60000,
    "maxOutputBytes": 32768,
    "events": {
      "SessionStart": [
        {
          "matcher": "startup|clear|compact",
          "hooks": [
            {
              "type": "command",
              "command": "echo agent-dev-toolkit-zcode-hooks",
              "enabled": true
            }
          ]
        }
      ],
      "PreToolUse": [
        {
          "matcher": "Write|Edit|Bash|PowerShell",
          "hooks": [
            {
              "type": "command",
              "command": "pwsh -NoProfile -File hooks/guard-pre-tool.ps1",
              "enabled": true
            }
          ]
        }
      ]
    }
  }
}
