{
  "description": "Codex plugin PreToolUse catch-all authorization guard for agent-dev-toolkit (trust via /hooks is manual).",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File \"${PLUGIN_ROOT}/hooks/guard-pre-tool.ps1\"",
            "statusMessage": "Checking path/secrets policy"
          }
        ]
      }
    ]
  }
}