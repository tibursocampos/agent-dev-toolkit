{
  "description": "Codex plugin PreToolUse path/secrets guards for agent-dev-toolkit (files only; trust via /hooks is manual).",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File \"${PLUGIN_ROOT}/hooks/guard-pre-tool.ps1\"",
            "statusMessage": "Checking path/secrets policy"
          }
        ]
      },
      {
        "matcher": "apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File \"${PLUGIN_ROOT}/hooks/guard-pre-tool.ps1\"",
            "statusMessage": "Checking path/secrets policy"
          }
        ]
      }
    ]
  }
}
