{
  "tools": [
    {
      "name": "fixture-analyzer",
      "command": "powershell.exe",
      "arguments": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", ".tools/emit-diagnostic.ps1", "{changed}", "password=fixture-secret-value"],
      "scope": "src/Widget.cs",
      "findingPattern": "(?<file>[^\\r\\n(]+)\\((?<line>\\d+)\\):\\s*(?<severity>warning|error|info)\\s+(?<rule>[A-Z]+\\d+).*"
    },
    {
      "name": "missing-fixture-tool",
      "command": "agent-dev-toolkit-tool-that-does-not-exist",
      "arguments": [],
      "scope": "src/"
    },
    {
      "name": "fixture-long-output",
      "command": "powershell.exe",
      "arguments": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", ".tools/emit-diagnostic.ps1", "long-output"],
      "scope": "src/"
    }
  ]
}
